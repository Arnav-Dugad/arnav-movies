{
  // Cloudflare Workers (free plan): static site in ./public plus a small API in worker.js.
  // Secrets: `npx wrangler secret put TMDB_KEY` (optional: OPENSUBTITLES_KEY).
  "name": "arnav-movies",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "arnav-movies-db", "database_id": "dd5b1133-c303-429b-ad4e-a05cddf8fb65" }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true }
}
