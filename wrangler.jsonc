{
  // Static site on Cloudflare Workers (free plan). `npx wrangler deploy` publishes ./public.
  "name": "lumen-cinema",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
